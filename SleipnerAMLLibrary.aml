  <SystemUnitClassLib Name="DocumentClassLibrary">
    <SystemUnitClass Name="SCD">
      <Description>System Control Diagram</Description>
      <Attribute Name="DrawingSize" AttributeDataType="xs:string">
        <Description>Drawing size, restricted to A1 ref ISO 5457</Description>
        <DefaultValue>A1</DefaultValue>
        <Value />
        <Constraint Name="Requirement">
          <NominalScaledType>
            <RequiredValue>A1</RequiredValue>
          </NominalScaledType>
        </Constraint>
      </Attribute>
      <Attribute Name="Orientation" AttributeDataType="xs:string">
        <Description>Restricted to Landscape</Description>
        <DefaultValue>Landscape</DefaultValue>
        <Value />
        <Constraint Name="Requirement">
          <NominalScaledType>
            <RequiredValue>Landscape</RequiredValue>
          </NominalScaledType>
        </Constraint>
      </Attribute>
      <Attribute Name="CoordinateSystem" AttributeDataType="xs:string">
        <Description>https://en.wikipedia.org/wiki/Cartesian_coordinate_system</Description>
        <DefaultValue />
        <Value />
        <Constraint Name="Requirement">
          <NominalScaledType>
            <RequiredValue>right-handed</RequiredValue>
          </NominalScaledType>
        </Constraint>
      </Attribute>
      <Attribute Name="DrawingOrigin" AttributeDataType="xs:string">
        <Description />
        <DefaultValue />
        <Value />
        <Constraint Name="Requirement">
          <NominalScaledType>
            <RequiredValue>Lower left corner</RequiredValue>
          </NominalScaledType>
        </Constraint>
      </Attribute>
      <Attribute Name="Scale" AttributeDataType="xs:string">
        <Description />
        <DefaultValue />
        <Value />
      </Attribute>
    </SystemUnitClass>

        </Constraint>
      </Attribute>
      <Attribute Name="Scale" AttributeDataType="xs:string">
        <Description />
        <DefaultValue />
        <Value />
      </Attribute>
    </SystemUnitClass>
    <SystemUnitClass Name="ContextHiding" ID="6c71de7c-daad-4a4b-9a30-aa86d48049a8">
      <Description>Context and Hiding document</Description>
    </SystemUnitClass>
    <SystemUnitClass Name="ShutdownHierarchy" ID="19c83e4c-a700-4683-baed-49488b5caf5d">
      <Description>Shutdown Hierarchy</Description>
      <Attribute Name="DrawingSize" AttributeDataType="xs:string">
        <Description>Drawing size, restricted to A1 ref ISO 5457</Description>
        <DefaultValue>A1</DefaultValue>
        <Value />
        <Constraint Name="Requirement">
          <NominalScaledType>
            <RequiredValue>A1</RequiredValue>
          </NominalScaledType>

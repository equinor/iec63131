            <RequiredValue>In</RequiredValue>
            <RequiredValue>Out</RequiredValue>
          </NominalScaledType>
        </Constraint>
      </Attribute>
      <InterfaceClass Name="In" RefBaseClassPath="InterfaceClassLibrary/DeviceConnection">

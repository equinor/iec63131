    <SystemUnitClass Name="VendorFunctionBlockClass">
      <Description>Vendor spesific Function Block Class library</Description>
      <Attribute Name="Layer" AttributeDataType="xs:string">
        <Description>Additional layers can be added by the project</Description>
        <DefaultValue />
        <Value />
        <Constraint Name="Standard">
          <NominalScaledType>
            <RequiredValue>11</RequiredValue>
            <RequiredValue>12</RequiredValue>
            <RequiredValue>13</RequiredValue>
            <RequiredValue>14</RequiredValue>
          </NominalScaledType>
        </Constraint>
      </Attribute>
      <Attribute Name="X" Unit="mm" AttributeDataType="xs:decimal">
        <Description>X: The abscissa of a point is the signed measure of its projection on the primary axis</Description>
        <DefaultValue />
        <Value />
      </Attribute>
      <Attribute Name="Y" Unit="mm" AttributeDataType="xs:decimal">
        <Description>Y: The ordinate of a point is the signed measure of its projection on the secondary axis</Description>
        <DefaultValue />
        <Value />
      </Attribute>
      <Attribute Name="ControlNode" AttributeDataType="xs:string">
        <Description>Control system node</Description>
        <DefaultValue />
        <Value />
      </Attribute>
      <Attribute Name="ControlMode" AttributeDataType="xs:string">
        <Description>Function Block Control Mode</Description>
        <DefaultValue />
        <Value />
      </Attribute>
      <Attribute Name="ControlFunctionIntegration" AttributeDataType="xs:string">
        <Description>Control Function Integration Level</Description>
        <DefaultValue>I</DefaultValue>
        <Value />
        <Constraint Name="LegalValues">
          <NominalScaledType>
            <RequiredValue>I</RequiredValue>
            <RequiredValue>II</RequiredValue>
            <RequiredValue>III</RequiredValue>
          </NominalScaledType>
        </Constraint>
      </Attribute>
      <Attribute Name="AdditionalText" AttributeDataType="xs:string">
        <Description />
        <DefaultValue />
        <Value />
      </Attribute>
      <Attribute Name="NoteRef" AttributeDataType="xs:string">
        <Description>Reference to Drawing Note object GUID</Description>
        <DefaultValue />
        <Value />
        <Constraint Name="aml-RegExp">
          <UnknownType>
            <Requirements>^[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){4}[0-9A-Fa-f]{8}$</Requirements>
          </UnknownType>
        </Constraint>
      </Attribute>
      <SupportedRoleClass RefRoleClassPath="AutomationMLBaseRoleClassLib/AutomationMLBaseRole/LogicObject" />
      <SystemUnitClass Name="KM" ID="dfc80911-0c21-4710-8860-4a5b9b9bdab9" RefBaseClassPath="FunctionBlockLibrary/VendorFunctionBlockClass" />
      <SystemUnitClass Name="ABB" ID="c0257568-1ad0-478b-a844-17eec298b01f" RefBaseClassPath="FunctionBlockLibrary/VendorFunctionBlockClass">
        <SystemUnitClass Name="HSO" ID="REUSEcommon.HSO" RefBaseClassPath="FunctionBlockLibrary/VendorFunctionBlockClass/ABB">
          <Description>Control Module type is intended for manually operating of binary process signals from HMI.</Description>
          <Attribute Name="PEnManAuto" AttributeDataType="xs:boolean" RefAttributeType="AttributeTypeLib/Parameter">
            <Description>IN Enable mode selection (True (and PAutoReset=false): Auto mode selection is enabled. False (or PAutoReset=true): Mode is set to Manual).</Description>
            <DefaultValue>default</DefaultValue>
          </Attribute>
          <Attribute Name="PDE" AttributeDataType="xs:boolean" RefAttributeType="AttributeTypeLib/Parameter">
            <Description>IN Enable functionevents (false = no event).</Description>
            <DefaultValue>true</DefaultValue>
          </Attribute>
          <Attribute Name="PPri" AttributeDataType="xs:integer" RefAttributeType="AttributeTypeLib/Parameter">
            <Description>IN Severity for functionevents (Range 1-1000, else LVV + ParError, SV=1000).</Description>
            <DefaultValue>100</DefaultValue>
          </Attribute>
          <Attribute Name="PRestart" AttributeDataType="xs:boolean" RefAttributeType="AttributeTypeLib/Parameter">
            <Description>IN Enable multiple manual start commands (True (and PAutoReset=false): Allowed. False (or PAutoreset=true or auto mode): Disabled).</Description>
            <DefaultValue>false</DefaultValue>
          </Attribute>
          <Attribute Name="PGreenH" AttributeDataType="xs:boolean" RefAttributeType="AttributeTypeLib/Parameter">
            <Description>IN Enable green manualmode indication (True: Green, False: Blue).</Description>
            <DefaultValue>false</DefaultValue>
          </Attribute>
          <Attribute Name="PAutoReset" AttributeDataType="xs:boolean" RefAttributeType="AttributeTypeLib/Parameter">
            <Description>IN Enable automatic reset of Y output (True (and both PRestart and PEnManAuto are false): Y reset after 5s. False: No automatic reset of Y).</Description>
            <DefaultValue>false</DefaultValue>
          </Attribute>
